# Copy to .env and fill in real values. Loaded by common/config/main-local.php via symfony/dotenv.

# App behavior
SYSTEM_TYPE=AIMS
RESET_MENU_AT_LOGIN=1
ENABLE_POS_MODULES=0
ENABLE_BRANCHADD=0
QUERY_LIMITER=1000

# Decimal formatting
DECIMAL_CURRENCY=2
DECIMAL_UNITPRICE=2
DECIMAL_KGS=2
DECIMAL_QUANTITY=2
DECIMAL_FRONTEND_CURRENCY=2
DECIMAL_FRONTEND_QUANTITY=2

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASS=
DB_SCHEMA=web_universe
DB_CHARSET=utf8

# Release info
VERSION=rv.20211709
RELEASE=UNIVERSE
LAST_MODIF_ATTR=4001
